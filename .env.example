# ===== Python Dependency Auditor 環境變數範例 =====

# 翻譯模式: builtin / openai / gemini
TRANSLATION_MODE=builtin

# OpenAI (選用 - 僅 TRANSLATION_MODE=openai 時需要)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini (選用 - 僅 TRANSLATION_MODE=gemini 時需要)
# 建議模型: gemini-2.0-flash 或 gemma-4-31b-it
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-31b-it

# 系統時區 (預設台北)
TZ=Asia/Taipei
